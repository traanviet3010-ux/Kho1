# Configure these in Render Environment; do not commit actual secrets.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-character-password
SESSION_SECRET=replace-with-random-secret-of-at-least-32-characters
NODE_ENV=production
PORT=10000
MAX_UPLOAD_MB=75
REA_TIMEOUT_MS=180000
# For durable storage, attach Render Persistent Disk to this path:
DATA_DIR=/app/runtime-data
